# Copy this file to .env.deploy and fill in your values.
# .env.deploy is gitignored - it holds a real access token and must never be committed.

# SSH alias (see ~/.ssh/config) or host, used for rsync-ing the integration files.
HA_SSH_HOST=ha

# Base URL of your Home Assistant instance, used to call the REST API to restart it.
HA_URL=http://192.168.1.14:8123

# Long-lived access token: HA profile page -> Security tab -> Long-lived access tokens -> Create Token.
HA_TOKEN=
